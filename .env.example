# --- Forex Data Provider Credentials (FXCM) ---
# You can get your access token from the MyFXCM portal under "Token Management"
FXCM_API_TOKEN="YOUR_FXCM_API_TOKEN_HERE"
# Use 'demo' for demo accounts, 'real' for real accounts
FXCM_SERVER_MODE="demo"

# --- MetaTrader 5 Credentials ---
# These should match the account you are running on your MT5 Terminal.
MT5_LOGIN=12345678
MT5_PASSWORD="YOUR_MT5_PASSWORD_HERE"
MT5_SERVER="YOUR_BROKER_SERVER_NAME_HERE"
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe" # Example path for Windows

# --- Trading Parameters ---
FOREX_SYMBOL="BTC/USD" # Symbol as it appears on your MT5 broker
RISK_PERCENTAGE=1.0 # e.g., 1.0 means 1% of account balance per trade