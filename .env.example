# --- Forex L2 Data Provider Credentials (Example: OANDA) ---
# You will need to get these from your data provider's account settings.
OANDA_API_KEY="YOUR_OANDA_API_KEY_HERE"
OANDA_ACCOUNT_ID="YOUR_OANDA_ACCOUNT_ID_HERE"
# Use 'practice' for demo accounts, 'live' for real accounts
OANDA_ENVIRONMENT="practice"

# --- MetaTrader 5 Credentials ---
# These should match the account you are running on your MT5 Terminal.
MT5_LOGIN=12345678
MT5_PASSWORD="YOUR_MT5_PASSWORD_HERE"
MT5_SERVER="YOUR_BROKER_SERVER_NAME_HERE"
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe" # Example path for Windows

# --- Trading Parameters ---
FOREX_SYMBOL="BTCUSD" # Symbol as it appears on your MT5 broker
RISK_PERCENTAGE=1.0 # e.g., 1.0 means 1% of account balance per trade
