# --- FXOpen TickTrader API Credentials ---
# You must generate these from your FXOpen client portal for the DEMO environment.
FXOPEN_API_ID="YOUR_FXOPEN_WEB_API_ID"
FXOPEN_API_KEY="YOUR_FXOPEN_WEB_API_KEY"
FXOPEN_API_SECRET="YOUR_FXOPEN_WEB_API_SECRET"

# --- FXOpen TickTrader Server URLs ---
# A comma-separated list of potential WebSocket URLs for the DATA FEED.
# The script will try these in order to find a working one for your demo account.
FXOPEN_WEBSOCKET_URLS="wss://marginalttdemowebapi.fxopen.net/feed,wss://marginalttdemowebapi.fxopen.net:3000,wss://ttdemowebapi.soft-fx.com:8443/feed,wss://marginalttlivewebapi.fxopen.net:3000"

# The WebSocket URL for TRADE EXECUTION.
FXOPEN_WEBSOCKET_TRADE_URL="wss://marginalttdemowebapi.fxopen.net/trade"


# --- Trading Parameters ---
FOREX_SYMBOL="BTC/USD"
RISK_PERCENTAGE=1.0 # e.g., 1.0 means 1% of account balance per trade