# --- Forex Data Provider Credentials (FXOpen TickTrader API) ---
# You can get these from your FXOpen account portal.
FXOPEN_API_ID="YOUR_FXOPEN_WEB_API_ID"
FXOPEN_API_KEY="YOUR_FXOPEN_WEB_API_KEY"
FXOPEN_API_SECRET="YOUR_FXOPEN_WEB_API_SECRET"
# The server URL for the WebSocket Feed API
FXOPEN_WEBSOCKET_URL="wss://marginalttlivewebapi.fxopen.net:3000"

# --- MetaTrader 5 Configuration ---
# The script will connect to the MT5 terminal already running on your machine.
# You only need to provide the path to the terminal executable.
MT5_PATH="C:\\Program Files\\MetaTrader 5\\terminal64.exe" # Example path for Windows

# --- Trading Parameters ---
FOREX_SYMBOL="BTC/USD" # Symbol as it appears on your MT5 broker
RISK_PERCENTAGE=1.0 # e.g., 1.0 means 1% of account balance per trade