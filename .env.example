# --- FXOpen TickTrader API Credentials ---
# You can get these from your FXOpen account portal.
FXOPEN_API_ID="YOUR_FXOPEN_WEB_API_ID"
FXOPEN_API_KEY="YOUR_FXOPEN_WEB_API_KEY"
FXOPEN_API_SECRET="YOUR_FXOPEN_WEB_API_SECRET"

# --- FXOpen TickTrader Server URLs ---
# A comma-separated list of potential WebSocket URLs. The script will try them in order.
# One of these should work for your demo account.
FXOPEN_WEBSOCKET_URLS="wss://marginalttdemowebapi.fxopen.net/feed,wss://marginalttdemowebapi.fxopen.net:3000,wss://marginalttdemowebapi.fxopen.net:443/WS/Feed,wss://ttdemowebapi.soft-fx.com:8443/feed,wss://marginalttlivewebapi.fxopen.net:3000"

# The REST API URL for trade execution. This is for the DEMO environment.
FXOPEN_TRADE_URL="marginalttdemowebapi.fxopen.net"


# --- Trading Parameters ---
FOREX_SYMBOL="BTC/USD"
RISK_PERCENTAGE=1.0 # e.g., 1.0 means 1% of account balance per trade